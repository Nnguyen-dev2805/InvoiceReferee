# Streamlit Community Cloud secrets template.
#
# Do NOT commit a filled-in secrets.toml. On Streamlit Community Cloud, paste the
# real values into: App → Settings → Secrets (same TOML format as below). Locally
# the app reads .env instead, so this file is only needed for the deployed host.
#
# The app bridges any LLM_* secret into the process environment, so the same
# client_from_env() path works locally (.env) and deployed (st.secrets).
#
# Leave these unset to run the safe, reproducible deterministic fallback.

LLM_BASE_URL = "https://api.xkiro.com/v1"
LLM_API_KEY  = "sk-your-key-here"
LLM_MODEL    = "qwen/qwen3.6-plus:free"
LLM_TIMEOUT  = "30"
