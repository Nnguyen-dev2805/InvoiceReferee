*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
*.sqlite
*.sqlite-*
*.db
*.db-*
.DS_Store
