# InvoiceReferee local configuration. Copy to `.env` and fill real values.
# NEVER commit real credentials. `.env` is Git-ignored.
#
# The runtime loads this file at startup (repo-root `.env`); an explicitly
# exported environment variable always overrides the file.

# Runtime data root (Git-ignored). SQLite + artifacts/evidence live here.
DATA_ROOT=data

# Provider mode: `fake` (deterministic, no network) or `live` (real providers).
# The composition root requires an explicit value; there is no live->fake fallback.
# `fake` wires an EMPTY fake provider: it proves the wiring only and cannot
# evaluate a submitted case end-to-end (use Verify replay for that).
PROVIDER_MODE=fake

# ---------------------------------------------------------------------------
# Mistral OCR (required for live document reading)
# ---------------------------------------------------------------------------
# Missing key -> the OCR call fails with CONFIG_NOT_ACTIVE (never a fake pass).
MISTRAL_API_KEY=
# Must support include_blocks + confidence_scores_granularity=word.
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Optional; defaults to the official endpoint.
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ---------------------------------------------------------------------------
# Kimi / Moonshot (OpenAI-compatible chat, JSON mode)
# ---------------------------------------------------------------------------
# Two accepted credential forms (either one is enough):
#   1) a single API key used as a Bearer token:
KIMI_API_KEY=
#   2) the B0 token + secret pair, combined as "token.secret":
KIMI_TOKEN=
KIMI_SECRET=
# Point at any OpenAI-compatible endpoint (official, gateway, self-hosted).
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# ---------------------------------------------------------------------------
# OCR quality gate (review parameter, not a business probability)
# ---------------------------------------------------------------------------
# Words below this confidence become review candidates. Range (0, 1]. Default 0.85.
# NOTE: the active policy's word_review_threshold (config/demo-policy.json) is the
# value the pipeline re-derives with; this env var documents the proposed default.
OCR_WORD_REVIEW_THRESHOLD=0.85
