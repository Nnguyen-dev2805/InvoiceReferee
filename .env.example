# InvoiceReferee local configuration. Copy to .env and fill in.
# These are the only live-required settings; leave blank to run non-LIVE modes.
# No company grants, budgets or authority records belong in this file.

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=
XKIRO_API_KEY=
XKIRO_BASE_URL=
INVOICE_REFEREE_LLM_MODEL=

# LangSmith tracing is OPT-IN and never required for LIVE. Leave blank/off to
# run without telemetry; a tracing failure never blocks a business conclusion.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=invoice-referee
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
