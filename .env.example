# InvoiceReferee local configuration (T01). Copy to .env; never commit real values.
# Runtime data root (Git-ignored). Artifacts/evidence live under this path.
DATA_ROOT=data
# Provider mode: fake (deterministic fixtures) or live. Composition root must
# choose explicitly; there is no implicit live->fake fallback.
PROVIDER_MODE=fake
# Live provider credentials (empty by default). SDK/model/endpoint values are
# pinned by T05 after official-doc verification; do not put credentials in Git.
MISTRAL_API_KEY=
KIMI_API_KEY=
