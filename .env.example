# InvoiceReferee - biến môi trường
#
# Sao chép file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# KHÔNG commit .env. File .env đã được .gitignore chặn.

# ---------------------------------------------------------------------------
# Mistral OCR - bắt buộc để đọc chứng từ
# ---------------------------------------------------------------------------
# Thiếu key này thì OCR adapter là None và mọi hồ sơ đều trả NEEDS_HUMAN
# với finding OCR_NOT_CONFIGURED.
MISTRAL_API_KEY=your_mistral_api_key

# Tùy chọn. Mặc định: mistral-ocr-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest

# ---------------------------------------------------------------------------
# Kimi - bắt buộc để kiểm tra confidence và đối chiếu chéo nguồn
# ---------------------------------------------------------------------------
# Thiếu bất kỳ biến nào dưới đây thì reasoning adapter là None và hồ sơ cần
# bước này đều trả NEEDS_HUMAN với finding KIMI_NOT_CONFIGURED.
KIMI_TOKEN=your_rotated_token
KIMI_SECRET=your_rotated_secret
KIMI_BASE_URL=https://your-kimi-endpoint.example.com/v1

# Tùy chọn. Mặc định: moonshotai/Kimi-K3
KIMI_MODEL=moonshotai/Kimi-K3

# ---------------------------------------------------------------------------
# Ngưỡng chất lượng OCR
# ---------------------------------------------------------------------------
# Tùy chọn. Mặc định: 0.85. Phải nằm trong khoảng (0, 1].
# Từ có confidence thấp hơn ngưỡng này trở thành ứng viên cần review.
OCR_WORD_REVIEW_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# Nơi lưu hồ sơ
# ---------------------------------------------------------------------------
# Tùy chọn. Mặc định: <repo>/data
# Hồ sơ được ghi vào <giá trị>/submissions/{case_id}.
# INVOICE_REFEREE_DATA_DIR=
#
# ===========================================================================
# HƯỚNG DẪN DEPLOY LÊN STREAMLIT COMMUNITY CLOUD
# ===========================================================================
#
# 1. Vào share.streamlit.io -> app của bạn -> Settings -> Secrets.
#    (Hoặc điền ở mục "Advanced settings" ngay khi deploy lần đầu.)
#
# 2. Dán vào đó bằng cú pháp TOML - KHÁC với .env ở trên. Giá trị là chuỗi
#    PHẢI có dấu ngoặc kép. Copy nguyên khối dưới đây rồi thay giá trị thật:
#
#        MISTRAL_API_KEY = "sk-..."
#        MISTRAL_OCR_MODEL = "mistral-ocr-latest"
#        KIMI_TOKEN = "..."
#        KIMI_SECRET = "..."
#        KIMI_BASE_URL = "https://.../v1"
#        KIMI_MODEL = "moonshotai/Kimi-K3"
#        OCR_WORD_REVIEW_THRESHOLD = 0.85
#
#    GIỮ NGUYÊN Ở CẤP GỐC - không bọc trong [section] nào. Code đọc bằng
#    os.getenv(), mà theo tài liệu Streamlit chỉ các secret ở cấp gốc mới được
#    đưa vào biến môi trường:
#        https://docs.streamlit.io/develop/concepts/connections/secrets-management
#
#    SAI - os.getenv() KHÔNG đọc được, app sẽ chạy như thiếu key:
#        [mistral]
#        api_key = "sk-..."
#
#    LƯU Ý: .env ở trên không cần ngoặc kép vì python-dotenv tự xử lý. Chỉ
#    bản dán vào Streamlit secrets mới bắt buộc ngoặc kép.
#
# 3. Kiểm tra sau khi deploy: nộp một hồ sơ có bill ảnh + mô tả.
#    - Ra NEEDS_HUMAN ngay với OCR_NOT_CONFIGURED  -> key chưa được đọc.
#    - Ra PASS hoặc NEEDS_HUMAN bình thường        -> key đã hoạt động.
#    Xem thêm Manage app -> Logs.
#
# LƯU Ý: filesystem của Streamlit Cloud là tạm thời. Không set
# INVOICE_REFEREE_DATA_DIR thì hồ sơ ghi vào <repo>/data và sẽ MẤT khi app
# restart hoặc redeploy. Chỉ dùng dữ liệu tổng hợp cho demo công khai.
