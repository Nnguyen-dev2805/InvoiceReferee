# InvoiceReferee local configuration. Copy to `.env` and fill real values.
# NEVER commit real credentials. `.env` is Git-ignored.
#
# The runtime loads this file at startup (repo-root `.env`); an explicitly
# exported environment variable always overrides the file.

# ---------------------------------------------------------------------------
# Provider mode for the settlement core
# ---------------------------------------------------------------------------
# `fake` (default) wires the offline structured-ledger reader (mode
# FAKE_OR_REPLAY). `live` wires Mistral OCR + xkiro; missing keys then fail
# loudly at startup with CONFIG_NOT_ACTIVE — there is NO live->fake fallback.
SETTLEMENT_PROVIDER_MODE=fake

# ---------------------------------------------------------------------------
# Live providers (only when SETTLEMENT_PROVIDER_MODE=live)
# ---------------------------------------------------------------------------
# Missing key -> the call fails with CONFIG_NOT_ACTIVE (never a fake pass).
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=mistralai/mistral-small-2603

# ---------------------------------------------------------------------------
# Settlement storage (optional; defaults live under data/settlement/)
# ---------------------------------------------------------------------------
# SETTLEMENT_DB_PATH=
# SETTLEMENT_ARTIFACT_ROOT=

# ---------------------------------------------------------------------------
# Company fixtures (backend-owned; absent = unknown context, malformed = error)
# ---------------------------------------------------------------------------
# B3 v1 verbal intake (b3-intake-v1): B3 company context
SETTLEMENT_B3_CONTEXT_PATH=
# B6→B7 linked settlement (b7-linked-intake-v1): B7 company/authority config
SETTLEMENT_B7_CONTEXT_PATH=

# ---------------------------------------------------------------------------
# Verify output directory (optional; default data/settlement/verify/)
# ---------------------------------------------------------------------------
# SETTLEMENT_VERIFY_DIR=
