# InvoiceReferee — LLM provider config (OpenAI-compatible).
# Copy to `.env` and fill in your key. Without LLM_API_KEY the system runs the
# deterministic fallback (decisions stay policy-correct via the Decision Guard).
#
# Provider-agnostic: point LLM_BASE_URL / LLM_MODEL at any OpenAI-compatible
# endpoint (xKiro, DeepSeek, OpenAI, a local gateway, ...).

# xKiro example (https://docs.xkiro.com):
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_API_KEY=
LLM_MODEL=claude-opus-4.8
LLM_TIMEOUT=30

# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- OCR engine (Supplier-Invoice document path) -----------------------------
# Default is the local PaddleOCR model (offline, private, no per-call cost).
# To use the hosted Mistral Document AI OCR instead (no local model download):
#   OCR_ENGINE=mistral
#   MISTRAL_API_KEY=...              # from https://console.mistral.ai/api-keys
#   MISTRAL_OCR_MODEL=ocr-4-1        # optional; default ocr-4-1 (bbox + block confidence)
#   MISTRAL_OCR_TIMEOUT=60           # optional, seconds
# OCR_ENGINE=paddle

# --- LLM-first semantic extraction -------------------------------------------
# Extraction IS the LLM: OCR blocks are mapped to fields by meaning and every
# mapping is verified against the cited blocks before use. There is no
# label/layout/fuzzy mapper to fall back to, so LLM_API_KEY is REQUIRED for the
# document path — without it extraction fails closed and no field is extracted.
#
# A document with many blocks needs a larger timeout than the default 30s; the
# recorded 60-block receipt takes ~60s.
#   LLM_TIMEOUT=180
