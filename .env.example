KIMI_TOKEN=your_rotated_token
KIMI_SECRET=your_rotated_secret
KIMI_BASE_URL=https://gpcyont--ep-kimi-k3-server.us-west.modal.direct/v1
KIMI_MODEL=moonshotai/Kimi-K3

# Mistral OCR
MISTRAL_API_KEY=

# OCR quality gate
OCR_WORD_REVIEW_THRESHOLD=0.85

# Local storage (optional; defaults to ./data)
INVOICE_REFEREE_DATA_DIR=

# UC-03 document pipeline (OCR -> confidence -> extraction)
UC03_DOCUMENT_PIPELINE_ENABLED=1
