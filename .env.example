# InvoiceReferee — LLM provider config (OpenAI-compatible).
# Copy to `.env` and fill in your key. Without LLM_API_KEY the system runs the
# deterministic fallback (decisions stay policy-correct via the Decision Guard).
#
# Provider-agnostic: point LLM_BASE_URL / LLM_MODEL at any OpenAI-compatible
# endpoint (xKiro, DeepSeek, OpenAI, a local gateway, ...).

# xKiro example (https://docs.xkiro.com):
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_API_KEY=
LLM_MODEL=claude-opus-4.8
LLM_TIMEOUT=30

# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- OCR engine (Supplier-Invoice document path) -----------------------------
# Default is the local PaddleOCR model (offline, private, no per-call cost).
# To use the hosted Mistral Document AI OCR instead (no local model download):
#   OCR_ENGINE=mistral
#   MISTRAL_API_KEY=...                    # from https://console.mistral.ai/api-keys
#   MISTRAL_OCR_MODEL=mistral-ocr-latest   # optional
#   MISTRAL_OCR_TIMEOUT=60                 # optional, seconds
# OCR_ENGINE=paddle
