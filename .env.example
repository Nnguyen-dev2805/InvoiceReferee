# InvoiceReferee local configuration. Copy to .env and fill in.
# These are the only live-required settings; leave blank to run non-LIVE modes.
# No company grants, budgets or authority records belong in this file.

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=
# Default LLM runtime (17/10/2026): Groq gpt-oss-20b.
# Kimi-K3 remains an explicit alternative (LLM_PROVIDER=kimi).
# Fill from local ignored config; never commit values. The endpoint host is
# private — no default URL lives in source.
LLM_PROVIDER=groq
KIMI_TOKEN=
KIMI_SECRET=
KIMI_BASE_URL=
KIMI_MODEL=moonshotai/Kimi-K3
KIMI_REASONING_EFFORT=low
# Explicit alternative: set LLM_PROVIDER=xkiro plus the three below.
XKIRO_API_KEY=
XKIRO_BASE_URL=
INVOICE_REFEREE_LLM_MODEL=

# Default Groq provider. Fill GROQ_API_KEY locally.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# LangSmith tracing is OPT-IN and never required for LIVE. Leave blank/off to
# run without telemetry; a tracing failure never blocks a business conclusion.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=invoice-referee
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=
